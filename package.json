{
  "name": "koishi-plugin-apng-two-frame",
  "version": "1.3.0",
  "description": "将两张图片合成为两帧 APNG，也可将视频转为 APNG 动图",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "npm run build && node --test test/*.test.js"
  },
  "keywords": [
    "koishi",
    "plugin",
    "apng",
    "幻影坦克",
    "表情包",
    "视频"
  ],
  "license": "MIT",
  "contributors": [
    "Alec <469405634@qq.com>"
  ],
  "homepage": "https://github.com/DNAlec/koishi-plugin-apng-two-frame",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DNAlec/koishi-plugin-apng-two-frame.git"
  },
  "peerDependencies": {
    "koishi": "^4.0.0",
    "koishi-plugin-puppeteer": "^3.9.0"
  },
  "devDependencies": {
    "koishi": "^4.18.11",
    "koishi-plugin-puppeteer": "^3.9.0",
    "typescript": "^5.5.0"
  },
  "koishi": {
    "description": {
      "zh": "将两张图片合成为两帧 APNG：第一张作缩略图，点开后显示第二张。支持批量生成、视频转 APNG（超时可分割、共用封面帧），以及合并转发发送。",
      "en": "Combine two images into a two-frame APNG: thumbnail vs opened view. Supports batch generation and converting video to APNG, with optional duration splitting and a shared first-frame thumbnail."
    },
    "service": {
      "required": [
        "http",
        "puppeteer"
      ],
      "optional": [
        "ffmpeg"
      ]
    }
  }
}
